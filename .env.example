# Default: local-only. Copy to .env and adjust for a trusted LAN deployment.
INVEST_BIND_ADDRESS=127.0.0.1
INVEST_PORT=8080
# Explicit comma-separated hostnames/IPs, without scheme or port. No wildcard.
INVEST_ALLOWED_HOSTS=
# For a LAN server, initialize /secrets/access.json, then enable login:
# INVEST_AUTH_FILE=/secrets/access.json
# Set to 1 only when accessed over HTTPS:
INVEST_COOKIE_SECURE=0
# Never place a broker token or an encryption key here. Connect through the UI.
